    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Share of routed requests that returned a 5xx. It leaves out requests that match no route (path=\"Unknown\"), which are mostly scanner traffic. PromEx creates each counter at 1 on its first request, and increase() ignores that first sample. So the query counts a series that is new in the window by its whole value, or a route's first 500 after a deploy would read 0%.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "axisSoftMax": 0.05,
            "barAlignment": 0,
            "barWidthFactor": 0.6,
            "drawStyle": "line",
            "fillOpacity": 0,
            "gradientMode": "scheme",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "auto",
            "showValues": false,
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "single",
          "sort": "none"
        }
      },
      "pluginVersion": "13.2.3",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(sum(\n  (increase(flick_prom_ex_phoenix_http_requests_total{job=\"flick\", status=~\"5..\", path!=\"Unknown\"}[$__rate_interval]) and flick_prom_ex_phoenix_http_requests_total{job=\"flick\", status=~\"5..\", path!=\"Unknown\"} offset $__rate_interval)\n  or (flick_prom_ex_phoenix_http_requests_total{job=\"flick\", status=~\"5..\", path!=\"Unknown\"} unless flick_prom_ex_phoenix_http_requests_total{job=\"flick\", status=~\"5..\", path!=\"Unknown\"} offset $__rate_interval)\n) or vector(0))\n/ sum(\n  (increase(flick_prom_ex_phoenix_http_requests_total{job=\"flick\", path!=\"Unknown\"}[$__rate_interval]) and flick_prom_ex_phoenix_http_requests_total{job=\"flick\", path!=\"Unknown\"} offset $__rate_interval)\n  or (flick_prom_ex_phoenix_http_requests_total{job=\"flick\", path!=\"Unknown\"} unless flick_prom_ex_phoenix_http_requests_total{job=\"flick\", path!=\"Unknown\"} offset $__rate_interval)\n)",
          "legendFormat": "5xx",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Server error rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Requests that match no route, by status. Most come from scanners that probe for WordPress and PHP paths, so they are not server errors.",
