{
  "title": "Flick business",
  "uid": "flick-business",
  "description": "How Flick is used, counted from its database through a read-only role.",
  "schemaVersion": 42,
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "refresh": "",
  "tags": [],
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "All time",
      "description": "Every ballot and vote in the database, regardless of the time range. Counts only: no titles, answers, or names.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT\n  count(*) AS \"Ballots\",\n  count(published_at) AS \"Published\",\n  count(closed_at) AS \"Closed\",\n  (SELECT count(*) FROM votes) AS \"Votes\"\nFROM ballots"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Ballots per day",
      "description": "Ballots created, published, and closed each day (UTC).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "barAlignment": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(ts, '1d', 0), event AS metric, count(*) AS value\nFROM (\n  SELECT inserted_at AS ts, 'created' AS event FROM ballots\n  UNION ALL SELECT published_at, 'published' FROM ballots WHERE published_at IS NOT NULL\n  UNION ALL SELECT closed_at, 'closed' FROM ballots WHERE closed_at IS NOT NULL\n) events\nWHERE $__timeFilter(ts)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Votes per day",
      "description": "Votes cast each day (UTC).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "barAlignment": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(inserted_at, '1d', 0), count(*) AS votes\nFROM votes\nWHERE $__timeFilter(inserted_at)\nGROUP BY 1\nORDER BY 1"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Votes per published ballot",
      "description": "For ballots published in the time range: how many votes each one received.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT\n  percentile_cont(0.5) WITHIN GROUP (ORDER BY n) AS \"Median\",\n  round(avg(n), 1) AS \"Mean\",\n  max(n) AS \"Most\",\n  count(*) FILTER (WHERE n = 0) AS \"Ballots with no votes\"\nFROM (\n  SELECT ballots.id, count(votes.id) AS n\n  FROM ballots\n  LEFT JOIN votes ON votes.ballot_id = ballots.id\n  WHERE ballots.published_at IS NOT NULL AND $__timeFilter(ballots.published_at)\n  GROUP BY ballots.id\n) per_ballot"
        }
      ]
    }
  ]
}
