{
  "title": "Flick business",
  "uid": "flick-business",
  "description": "Counts of ballots and votes, read from Flick's database.",
  "schemaVersion": 42,
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "refresh": "",
  "tags": [],
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "All time",
      "description": "Every ballot and vote in the database, regardless of the time range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT\n  count(*) AS \"Ballots\",\n  count(published_at) AS \"Published\",\n  count(closed_at) AS \"Closed\",\n  (SELECT count(*) FROM votes) AS \"Votes\"\nFROM ballots"
        }
      ]
    },
    {
      "id": 2,
      "type": "barchart",
      "title": "Ballots per day",
      "description": "Ballots created, published, and closed each day (UTC), side by side.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1,
            "gradientMode": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "time",
        "orientation": "vertical",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.97,
        "showValue": "never",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 100,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH days AS (\n  SELECT generate_series(\n    date_trunc('day', $__timeFrom()::timestamp),\n    date_trunc('day', $__timeTo()::timestamp),\n    interval '1 day'\n  ) AS day\n),\nevents AS (\n  SELECT inserted_at AS ts, 'created' AS event FROM ballots\n  UNION ALL SELECT published_at, 'published' FROM ballots WHERE published_at IS NOT NULL\n  UNION ALL SELECT closed_at, 'closed' FROM ballots WHERE closed_at IS NOT NULL\n)\nSELECT\n  days.day AS \"time\",\n  count(*) FILTER (WHERE events.event = 'created') AS \"created\",\n  count(*) FILTER (WHERE events.event = 'published') AS \"published\",\n  count(*) FILTER (WHERE events.event = 'closed') AS \"closed\"\nFROM days\nLEFT JOIN events\n  ON date_trunc('day', events.ts) = days.day AND $__timeFilter(events.ts)\nGROUP BY 1\nORDER BY 1"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Votes per day",
      "description": "Votes cast each day (UTC).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "barAlignment": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(inserted_at, '1d', 0), count(*) AS votes\nFROM votes\nWHERE $__timeFilter(inserted_at)\nGROUP BY 1\nORDER BY 1"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Votes per published ballot",
      "description": "Votes per ballot, for ballots published in the time range: the median, mean, and most, and how many ballots got no votes.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT\n  percentile_cont(0.5) WITHIN GROUP (ORDER BY n) AS \"Median\",\n  round(avg(n), 1) AS \"Mean\",\n  max(n) AS \"Most\",\n  count(*) FILTER (WHERE n = 0) AS \"Ballots with no votes\"\nFROM (\n  SELECT ballots.id, count(votes.id) AS n\n  FROM ballots\n  LEFT JOIN votes ON votes.ballot_id = ballots.id\n  WHERE ballots.published_at IS NOT NULL AND $__timeFilter(ballots.published_at)\n  GROUP BY ballots.id\n) per_ballot"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Time to publish",
      "description": "Median time from creating a ballot to publishing it, for ballots created in the time range. Drafts have no time to publish, so the count shows how many of those ballots are published.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Published"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT\n  percentile_cont(0.5) WITHIN GROUP (ORDER BY extract(epoch FROM published_at - inserted_at)) AS \"Median\",\n  count(published_at) AS \"Published\"\nFROM ballots\nWHERE $__timeFilter(inserted_at)"
        }
      ]
    }
  ]
}
