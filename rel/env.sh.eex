#!/bin/sh

# Erlang distribution listens on every interface by default, and the cookie
# would be the only guard against other services on Render's private network.
# Binding EPMD and the distribution port to loopback keeps `bin/flick remote`
# working inside the container and unreachable from anywhere else. The node
# name uses `localhost` so `remote` looks the node up on loopback too.
export RELEASE_DISTRIBUTION=sname
export RELEASE_NODE=<%= @release.name %>@localhost
export ERL_EPMD_ADDRESS=127.0.0.1
export ELIXIR_ERL_OPTIONS="-kernel inet_dist_use_interface {127,0,0,1}"
